{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interpreter-trainer-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 1000,
    "subrequests": 10
  },
  "observability": {
    "enabled": true
  }
}
