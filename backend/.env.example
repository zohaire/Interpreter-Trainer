# Server-only secrets. Supply through your deployment secret manager.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
NODE_ENV=production
PORT=8080
# OpenAI-compatible endpoint, including /v1 when required. No provider is hard-coded.
PRIMARY_BASE_URL=
PRIMARY_MODEL=
PRIMARY_API_KEY=
SECONDARY_BASE_URL=
SECONDARY_MODEL=
SECONDARY_API_KEY=
# A self-hosted Ollama process on the backend host can use:
# PRIMARY_BASE_URL=http://127.0.0.1:11434/v1
# PRIMARY_MODEL=<model you installed and tested>
# PRIMARY_API_KEY=
